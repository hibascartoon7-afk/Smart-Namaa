# NAMAA Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to version control.

# Supabase (pre-configured by the platform — do not change unless you know what you're doing)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side secrets (Edge Functions only — NOT exposed to the browser)
# Set these via the Supabase dashboard or CLI: supabase secrets set KEY=value
OPENAI_API_KEY=

# Optional: Weather API provider (e.g. OpenWeatherMap, Open-Meteo)
# WEATHER_API_KEY=
# WEATHER_API_PROVIDER=openweathermap
# FIELD_LATITUDE=24.7136
# FIELD_LONGITUDE=46.6753
