{
  "name": "namaa-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NAMAA decision engine, tests and Supabase backend (the web app is in ./namaa-agritech)",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync-engine": "node scripts/sync-engine.mjs",
    "check-sync": "node scripts/sync-engine.mjs --check",
    "ingest-knowledge": "node scripts/ingest-knowledge.mjs",
    "import-growth-stages": "node scripts/import-growth-stages.mjs",
    "check-functions": "node scripts/check-functions.mjs",
    "test:firmware": "bash firmware/tests/run.sh"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@supabase/supabase-js": "^2.57.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
